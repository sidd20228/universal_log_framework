{
  "config_version": "ulpf-mapping/1",
  "id": "enterprise-demo-cef",
  "version": "1.0.0",
  "rules": [
    {
      "id": "class-uid",
      "from": "fields.header.device_product",
      "to": "event.class_uid",
      "convert": "lowercase",
      "lookup": "source-class-uid",
      "required": true
    },
    {
      "id": "class-name",
      "from": "fields.header.device_product",
      "to": "event.class_name",
      "convert": "lowercase",
      "lookup": "source-class-name",
      "required": true
    },
    {
      "id": "action",
      "from": "fields.extension.act",
      "to": "event.action",
      "convert": "lowercase",
      "lookup": "action",
      "required": true
    },
    {
      "id": "source-ip",
      "from": "fields.extension.src",
      "to": "event.src_endpoint.ip",
      "convert": "ip",
      "required": true
    },
    {
      "id": "destination-ip",
      "from": "fields.extension.dst",
      "to": "event.dst_endpoint.ip",
      "convert": "ip",
      "required": true
    }
  ],
  "taxonomies": {
    "source-class-uid": {
      "4001": [
        "palo alto firewall",
        "asa",
        "qradar ips"
      ],
      "3002": [
        "windows security",
        "okta system log",
        "microsoft entra id"
      ],
      "6003": [
        "aws cloudtrail",
        "kubernetes audit",
        "paymentapp",
        "saas audit export"
      ],
      "1007": [
        "crowdstrike falcon"
      ],
      "4002": [
        "nginx access"
      ],
      "1008": [
        "linux syslog"
      ],
      "6005": [
        "oracle audit"
      ]
    },
    "source-class-name": {
      "Network Activity": [
        "palo alto firewall",
        "asa",
        "qradar ips"
      ],
      "Authentication": [
        "windows security",
        "okta system log",
        "microsoft entra id"
      ],
      "API Activity": [
        "aws cloudtrail",
        "kubernetes audit",
        "paymentapp",
        "saas audit export"
      ],
      "Process Activity": [
        "crowdstrike falcon"
      ],
      "HTTP Activity": [
        "nginx access"
      ],
      "Event Log Activity": [
        "linux syslog"
      ],
      "Datastore Activity": [
        "oracle audit"
      ]
    },
    "action": {
      "allow": [],
      "deny": []
    }
  }
}
