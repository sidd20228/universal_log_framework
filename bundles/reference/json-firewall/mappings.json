{
  "config_version": "ulpf-mapping/1",
  "id": "reference-json-firewall",
  "version": "1.0.0",
  "rules": [
    {"id":"class-uid","from":"fields.event_type","to":"event.class_uid","convert":"lowercase","lookup":"traffic-class-uid","required":true},
    {"id":"class-name","from":"fields.event_type","to":"event.class_name","convert":"lowercase","lookup":"traffic-class-name","required":true},
    {"id":"activity-id","from":"fields.event_type","to":"event.activity_id","convert":"lowercase","lookup":"traffic-activity-id"},
    {"id":"activity","from":"fields.event_type","to":"event.activity","convert":"lowercase","lookup":"traffic-activity"},
    {"id":"event-time","from":"fields.observed_at","to":"event.time","convert":"timestamp","timestamp_layouts":["RFC3339Nano"]},
    {"id":"action","from":"fields.disposition","to":"event.action","convert":"lowercase","lookup":"network-action","required":true},
    {"id":"status","from":"fields.status","to":"event.status","convert":"lowercase"},
    {"id":"severity-id","from":"fields.severity_id","to":"event.severity_id","convert":"integer"},
    {"id":"severity","from":"fields.severity","to":"event.severity","convert":"lowercase","lookup":"severity"},
    {"id":"source-ip","from":"fields.source_address","to":"event.src_endpoint.ip","convert":"ip","required":true},
    {"id":"source-port","from":"fields.source_port","to":"event.src_endpoint.port","convert":"port"},
    {"id":"source-host","from":"fields.source_host","to":"event.src_endpoint.hostname","convert":"lowercase"},
    {"id":"source-mac","from":"fields.source_mac","to":"event.src_endpoint.mac","convert":"lowercase"},
    {"id":"destination-ip","from":"fields.destination_address","to":"event.dst_endpoint.ip","convert":"ip","required":true},
    {"id":"destination-port","from":"fields.destination_port","to":"event.dst_endpoint.port","convert":"port"},
    {"id":"protocol-name","from":"fields.transport","to":"event.connection_info.protocol_name","convert":"lowercase"},
    {"id":"protocol-number","from":"fields.protocol_number","to":"event.connection_info.protocol_num","convert":"integer"},
    {"id":"device-type","from":"fields.device_type","to":"event.device.type","convert":"lowercase","lookup":"device-type"},
    {"id":"device-host","from":"fields.device_host","to":"event.device.hostname","convert":"lowercase"},
    {"id":"device-vendor","from":"fields.device_vendor","to":"event.device.vendor_name","convert":"string"},
    {"id":"device-product","from":"fields.device_product","to":"event.device.product_name","convert":"string"},
    {"id":"tenant-zone","from":"fields.zone","to":"event.extensions.reference.zone","convert":"lowercase"}
  ]
}
