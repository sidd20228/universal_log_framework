{
  "config_version": "ulpf-config/1",
  "deployment": {
    "environment_id": "lab",
    "instance_id": "node-a",
    "tenant_id": "demo",
    "api_token_ref": "plaintext-secret"
  },
  "listeners": [
    {
      "id": "http-8080",
      "kind": "http",
      "address": "127.0.0.1:8080",
      "max_event_bytes": 1048576
    }
  ],
  "processing": {
    "workers": 4,
    "parser_timeout": "100ms",
    "detection_threshold": 0.8,
    "ambiguity_margin": 0.1
  },
  "storage": {
    "raw_root": "/var/lib/ulpf/raw",
    "sqlite_path": "/var/lib/ulpf/control.db",
    "high_watermark_percent": 85
  },
  "retention": {
    "raw_days": 7
  },
  "connectors": [
    {
      "id": "webhook",
      "kind": "http",
      "required": false,
      "endpoint": "https://siem.example.invalid/events",
      "timeout": "5s",
      "auth_token": "plaintext-secret"
    }
  ]
}
